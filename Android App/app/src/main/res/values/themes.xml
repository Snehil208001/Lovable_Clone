<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.AuraCode" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/aura_background</item>
        <item name="android:statusBarColor">@color/aura_background</item>
        <item name="android:navigationBarColor">@color/aura_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.AuraCode.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/aura_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.AuraCode</item>
    </style>

</resources>
