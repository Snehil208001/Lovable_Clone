# Copy to config.env and fill in values:
#   cp deploy/azure/config.env.example deploy/azure/config.env

export SUBSCRIPTION_ID=""
export LOCATION="eastus"
export RESOURCE_GROUP="auracode-rg"

export ACR_NAME="auracodeacr"          # globally unique, alphanumeric only
export KEY_VAULT_NAME="auracode-kv"    # globally unique

export POSTGRES_SERVER="auracode-pg"   # becomes auracode-pg.postgres.database.azure.com
export DB_NAME="auracode"
export DB_USER="auracodeadmin"
export DB_PASSWORD=""

export CONTAINER_ENV="auracode-env"
export BACKEND_APP="auracode-api"
export FRONTEND_APP="auracode-web"
export MINIO_APP="auracode-minio"

export MINIO_ACCESS_KEY="minioadmin"
export MINIO_SECRET_KEY=""             # strong password
export MINIO_PROJECT_BUCKET="auracode-projects"

# Filled after first deploys
export BACKEND_URL=""
export FRONTEND_URL=""
export MINIO_URL=""

# App secrets (also stored in Key Vault)
export JWT_SECRET_KEY=""
export OPENAI_API_KEY=""
export STRIPE_API_KEY=""
export STRIPE_WEBHOOK_SECRET=""
export STRIPE_DEFAULT_PRICE_ID=""
export CASHFREE_APP_ID=""
export CASHFREE_SECRET_KEY=""
export CASHFREE_ENV="PRODUCTION"
export CASHFREE_NOTIFY_URL=""
export CASHFREE_DEFAULT_AMOUNT_INR="999"
