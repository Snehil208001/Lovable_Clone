# Copy to config.env and fill in values. Sourced by deploy/gcp/*.sh
#   cp deploy/gcp/config.env.example deploy/gcp/config.env

export PROJECT_ID="your-gcp-project-id"
export REGION="us-central1"
export AR_REPO="auracode"

export CLOUD_SQL_INSTANCE="auracode-pg"
export DB_NAME="auracode"
export DB_USER="auracode"
# Prefer generating a strong password; also stored in Secret Manager as DB_PASSWORD
export DB_PASSWORD=""

export GCS_BUCKET="${PROJECT_ID}-auracode-projects"

export BACKEND_SERVICE="auracode-api"
export FRONTEND_SERVICE="auracode-web"

# Filled after first backend deploy (or set manually)
export BACKEND_URL=""
export FRONTEND_URL=""

# App secrets (also loaded into Secret Manager by 04-secrets.sh)
export JWT_SECRET_KEY=""
export OPENAI_API_KEY=""
export STRIPE_API_KEY=""
export STRIPE_WEBHOOK_SECRET=""
export STRIPE_DEFAULT_PRICE_ID=""

# GCS HMAC keys (created by 03-gcs-bucket.sh or Cloud Console Interoperability)
export MINIO_ACCESS_KEY=""
export MINIO_SECRET_KEY=""
